# PostgreSQL из docker-compose.yml: docker compose up -d db
DATABASE_URL=postgresql+psycopg://kvitto:kvitto@localhost:5433/kvitto
# Секрет подписи вебхуков банка: X-Signature = HMAC-SHA256(тело запроса) в hex.
# Значение только для локального запуска — в продакшене задайте свой случайный секрет.
WEBHOOK_SECRET=dev-webhook-secret
